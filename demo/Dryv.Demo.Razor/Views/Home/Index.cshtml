@model RegistrationModel

<h2>Registration</h2>
<p>This demo uses <strong>Dryv</strong> with ASP.NET Core MVC and Razor views. Validation rules are defined in C# and automatically translated to JavaScript for client-side validation.</p>

<form asp-action="Index" method="post" id="registrationForm">
    <div>
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" />
        <span asp-validation-for="FirstName" class="field-validation-error"></span>
    </div>

    <div>
        <label asp-for="LastName"></label>
        <input asp-for="LastName" />
        <span asp-validation-for="LastName" class="field-validation-error"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>

    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password" class="field-validation-error"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" type="password" />
        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
    </div>

    <button type="submit">Register</button>
</form>

@section Scripts {
    <dryv-client-rules for="typeof(RegistrationModel)" name="registration" />

    <script src="https://cdn.jsdelivr.net/npm/dryvjs/dist/index.umd.js"></script>
    <script>
        (function () {
            var ruleSet = window.dryv.v['registration'];
            var form = document.getElementById('registrationForm');

            var options = Object.assign({}, dryvjs.defaultDryvOptions);
            var session = new dryvjs.DryvValidationSession(options, ruleSet);

            function getModel() {
                return {
                    firstName: form.querySelector('[name="FirstName"]').value,
                    lastName: form.querySelector('[name="LastName"]').value,
                    email: form.querySelector('[name="Email"]').value,
                    password: form.querySelector('[name="Password"]').value,
                    confirmPassword: form.querySelector('[name="ConfirmPassword"]').value
                };
            }

            function clearErrors() {
                form.querySelectorAll('.field-validation-error').forEach(function (el) {
                    el.textContent = '';
                });
                form.querySelectorAll('.input-validation-error').forEach(function (el) {
                    el.classList.remove('input-validation-error');
                });
            }

            function showErrors(results) {
                var fieldMap = {
                    firstName: 'FirstName',
                    lastName: 'LastName',
                    email: 'Email',
                    password: 'Password',
                    confirmPassword: 'ConfirmPassword'
                };

                results.forEach(function (r) {
                    if (r.result && r.result.type === 'error') {
                        var aspName = fieldMap[r.path] || r.path;
                        var span = form.querySelector('[data-valmsg-for="' + aspName + '"]');
                        var input = form.querySelector('[name="' + aspName + '"]');
                        if (span) span.textContent = r.result.text;
                        if (input) input.classList.add('input-validation-error');
                    }
                });
            }

            form.addEventListener('submit', async function (e) {
                clearErrors();

                var model = getModel();
                var validator = new dryvjs.DryvObjectValidator(model, session, undefined, options);
                var result = await validator.validate();

                if (!result.success) {
                    e.preventDefault();
                    showErrors(result.results);
                }
            });
        })();
    </script>
}
